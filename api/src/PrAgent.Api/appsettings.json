{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Sap": {
    "Mode": "Mock",
    "Mock": {
      "StatePath": ".data/mock-sap-prs.json",
      "FailWhenShortTextContains": "#SAPFAIL"
    },
    "S4Hana": {
      "BaseUrl": null,
      "Client": null,
      "CredentialsSecretId": null,
      "BudgetService": null,
      "TimeoutSeconds": 30
    }
  },

  "Auth": {
    "Mode": "Cognito",
    "CognitoRegion": null,
    "CognitoUserPoolId": null,
    "CognitoClientId": null
  },

  "Storage": {
    "Mode": "S3",
    "Bucket": null,
    "Prefix": "attachments/"
  },

  "Email": {
    "Mode": "Ses",
    "From": null,
    "RedirectAllTo": null
  },

  "Agent": {
    "BaseUrl": "http://127.0.0.1:8080",
    "ServiceToken": null
  },

  "App": {
    "WebBaseUrl": "http://localhost:5173",
    "TimeZone": "Asia/Jakarta",
    "SplitKeys": [ "itemType", "purchasingGroup", "budgetType" ]
  },

  "Outbox": {
    "Enabled": true,
    "PollSeconds": 2,
    "MaxAttempts": 4,
    "RetryDelaysSeconds": [ 5, 30, 120 ]
  },

  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },

  "Seed": {
    "DemoData": false
  }
}
