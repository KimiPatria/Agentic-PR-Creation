# Copy to .env and adjust. Lines starting with # are ignored.

# --- Model -----------------------------------------------------------------------------------
# bedrock  = Amazon Bedrock (needs AWS credentials: run `aws login` first)
# scripted = fixed script, no language model. For developing the plumbing without AWS.
AGENT_MODEL_PROVIDER=bedrock

# Must be an Amazon Nova model or inference profile your account can invoke in AGENT_AWS_REGION.
# List what you have:  aws bedrock list-inference-profiles --query "inferenceProfileSummaries[?contains(inferenceProfileId,'nova')].inferenceProfileId"
# Examples: apac.amazon.nova-pro-v1:0   us.amazon.nova-pro-v1:0   eu.amazon.nova-lite-v1:0
AGENT_MODEL_ID=
AGENT_AWS_REGION=
AGENT_TEMPERATURE=0.2
AGENT_MAX_TOKENS=2000

# Bedrock Guardrail created by the CDK stack (outputs GuardrailId and GuardrailVersion). Optional.
AGENT_GUARDRAIL_ID=
AGENT_GUARDRAIL_VERSION=

# --- SAP read tools (MCP) --------------------------------------------------------------------
# Local: the .NET API. In AWS: the AgentCore Gateway URL.
SAP_MCP_URL=http://localhost:5080/mcp
# Must equal Agent:ServiceToken in the API's configuration.
SAP_MCP_TOKEN=dev-only-agent-token

# --- Conversation memory ---------------------------------------------------------------------
# file = local folder, s3 = S3 bucket from the CDK stack, none = no memory between messages
AGENT_SESSION_STORE=file
AGENT_SESSION_DIR=.data/sessions
AGENT_SESSION_BUCKET=
AGENT_SESSION_PREFIX=agent-sessions/

AGENT_PORT=8080
