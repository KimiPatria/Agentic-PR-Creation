# Only needed when the API runs with Auth:Mode = Cognito. Copy to .env.local and fill in from the
# CDK stack outputs (UserPoolId, UserPoolClientId, UserPoolDomain). With Auth:Mode = Dev the web
# app shows a persona picker instead and none of this is read.

# https://cognito-idp.<region>.amazonaws.com/<UserPoolId>
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
# https://<domain-prefix>.auth.<region>.amazoncognito.com   (used for sign-out)
VITE_COGNITO_DOMAIN=
